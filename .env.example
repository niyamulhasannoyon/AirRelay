# ------------------------------------------------------------------------------
# 1. Administrator Authentication (Admin Panel: /admin)
# ------------------------------------------------------------------------------
# Ultra-strong random administrator username
ADMIN_USERNAME=relay_root_dMG8zTIoMm6rvcdO

# Ultra-strong cryptographically secure 36-char password (entropy > 200 bits)
ADMIN_PASSWORD=2f$SNWxKI!ZVG)nJ7v)%p@2cA=ByM79bM4nf

# Dedicated 256-bit secret key for signing admin JWT session tokens (HS256)
ADMIN_JWT_SECRET=6c42e0c7aae63f57df9c292fc6cd0f6b7dc122d9ec11d1fabb054d75be57db86

# ------------------------------------------------------------------------------
# 2. WebRTC & Signaling Security
# ------------------------------------------------------------------------------
# Master 256-bit HMAC key for ephemeral TURN credentials (/ice-servers)
SECRET_KEY=b2388586cb8792cd02606492762ed93a0fdca73200ff610754017a985c3de042

# Maximum concurrent WebSocket signaling connections before load shedding (HTTP 503 / WS 1013)
FILESYNC_MAX_WS=10000

# ------------------------------------------------------------------------------
# 3. Server & Networking
# ------------------------------------------------------------------------------
# Port for the HTTP/WebSocket server (Render uses 10000, local dev uses 8080)
PORT=10000

# Python version for cloud deployment
PYTHON_VERSION=3.11.9

# Allowed CORS origins (leave empty for same-origin)
CORS_ORIGINS=
